# Copy to .env and fill in. Never commit .env — only this template is tracked.

# Postgres. Locally this is a Homebrew instance; in production it's Neon.
# The pg_trgm extension must be enabled on the database (used by matching):
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
DATABASE_URL="postgresql://user@localhost:5432/macfound"

# Session signing key. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Only addresses at this domain may create an account. This is the trust model.
ALLOWED_EMAIL_DOMAIN="mcmaster.ca"

# Resend API key for delivering sign-in codes.
# Leave blank in development: codes print to the dev server terminal instead,
# so the whole auth flow works with no external account. Production refuses to
# start the flow without it rather than logging codes to a server log.
AUTH_RESEND_KEY=""

# Sender address for sign-in emails. Resend can only deliver to your own
# address until you verify a sending domain.
EMAIL_FROM="MacFound <login@example.com>"

# Vercel Blob, for item photos. Storage -> your blob store -> .env.local tab.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
