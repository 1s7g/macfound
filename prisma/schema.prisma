// MacFound — lost & found for McMaster University
//
// Design notes worth knowing (you'll get asked about these):
//  - Postgres, not SQLite/Mongo, specifically because the matching engine leans on
//    full-text search (tsvector) and trigram similarity (pg_trgm). Those are the
//    reason this app is more than a CRUD forum.
//  - Location and Category are enums, not free text. Free-text locations make
//    matching almost impossible; a fixed vocabulary makes it cheap and accurate.
//  - Claiming a found item is a structured step rather than a free-for-all:
//    the claimant writes an identifying description, and the finder — who has
//    the item in hand — decides. An earlier version stored a single "withheld
//    detail" on the post to compare against, but that anchored finders to one
//    right answer and would have them reject owners who described something
//    else equally identifying.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts, not from here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 required shape + our own fields on User)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique // enforced @mcmaster.ca at sign-in
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  // Notification preferences
  notifyOnMatch   Boolean @default(true)
  notifyOnMessage Boolean @default(true)
  notifyOnComment Boolean @default(true)

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  claims        Claim[]
  messages      Message[]
  notifications Notification[]
  reportsFiled  Report[]       @relation("ReportAuthor")

  conversationsAsFinder  Conversation[] @relation("ConversationFinder")
  conversationsAsSeeker  Conversation[] @relation("ConversationSeeker")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Fixed-window rate limiter, backed by the database rather than memory.
//
// Serverless functions don't share memory between invocations, so an in-process
// counter would reset constantly and enforce nothing. This matters most for the
// sign-in flow: a 6-digit code is only 1,000,000 possibilities, which is
// brute-forceable in minutes without a cap on verification attempts.
model RateLimit {
  key       String   @id // e.g. "signin:verify:someone@mcmaster.ca"
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Core domain
// ---------------------------------------------------------------------------

enum PostType {
  LOST
  FOUND
}

enum PostStatus {
  OPEN // active, looking
  RESOLVED // reunited with owner — the metric that proves the app works
  EXPIRED // auto-closed after the retention window
  REMOVED // taken down by moderation
}

enum Category {
  ELECTRONICS // phone, laptop, earbuds, charger
  BAGS // backpacks, totes, purses
  WATER_BOTTLE
  KEYS_AND_CARDS // keys, student card, wallet
  CLOTHING
  JEWELLERY
  BOOKS_AND_NOTES
  SPORTS_EQUIPMENT
  EYEWEAR
  OTHER
}

// Fixed vocabulary of campus locations.
//
// Every value here has real coordinates in src/lib/campus.ts, sourced from
// OpenStreetMap rather than from memory. Proximity is computed from those
// coordinates — there is deliberately no hand-maintained "nearby buildings"
// list, because the first one we wrote had five wrong pairs in it (MDCL and
// DBAC were listed as neighbours; they are 450m apart).
enum CampusLocation {
  // Libraries and central campus
  MILLS_LIBRARY
  THODE_LIBRARY
  MUSC // McMaster University Student Centre
  GILMOUR_HALL
  UNIVERSITY_HALL
  HAMILTON_HALL
  CHESTER_NEW_HALL
  TSH // Togo Salmon Hall
  KTH // Kenneth Taylor Hall
  LRW // L.R. Wilson Hall
  REFECTORY
  THE_HUB

  // Science
  BSB // Burke Science Building
  ABB // Arthur Bourns Building
  GSB // General Sciences Building
  LIFE_SCIENCES
  PSYCHOLOGY
  MDCL // Michael G. DeGroote Centre for Learning and Discovery
  IAHS // Institute for Applied Health Sciences

  // Engineering
  JHE // John Hodgins Engineering
  HATCH // Gerald Hatch Centre
  ETB // Engineering Technology Building
  ITB // Information Technology Building

  // Business
  DSB // DeGroote School of Business (main campus, not Ron Joyce in Burlington)

  // Athletics
  DBAC // David Braley Athletic Centre
  IVOR_WYNNE
  RON_JOYCE_STADIUM

  // Residences and residence life
  COMMONS_BUILDING
  PGCLL // Peter George Centre for Living and Learning
  LES_PRINCE
  BATES
  BRANDON_HALL
  WOODSTOCK_HALL
  HEDDEN_HALL
  MARY_KEYES
  MATTHEWS_HALL
  MOULTON_HALL
  WALLINGFORD_HALL
  MCKAY_HALL
  WHIDDEN_HALL
  EDWARDS_HALL

  // Off-campus and unpositioned. These have no coordinates, so the matcher
  // scores them by exact equality only.
  HSR_BUS
  CAMPUS_BUS_TERMINAL
  OUTDOOR_CAMPUS_GROUNDS
  OTHER
  UNKNOWN
}

model Post {
  id          String   @id @default(cuid())
  authorId    String
  type        PostType
  title       String
  description String

  category Category
  location CampusLocation
  // Free-text refinement of the location ("3rd floor near the printers").
  // Useful for humans; the enum above is what the matcher uses.
  locationDetail String?

  // When the item was lost or found — not when the post was created.
  // Matching compares these, so it must be user-supplied.
  occurredOn DateTime

  status     PostStatus @default(OPEN)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images        PostImage[]
  comments      Comment[]
  claims        Claim[]
  conversations Conversation[]
  reports       Report[]

  // Match rows where this post is the "source" and where it's the "candidate".
  matchesAsSource    Match[] @relation("MatchSource")
  matchesAsCandidate Match[] @relation("MatchCandidate")

  // Feed queries are always (type, status, createdAt desc) — index accordingly.
  @@index([type, status, createdAt])
  @@index([category, location, status])
  @@index([authorId])

  // Matching narrows by type + status + date before scoring.
  @@index([type, status, occurredOn], map: "Post_type_status_occurredOn_idx")

  // Trigram indexes backing similarity() in the matcher. Declared here rather
  // than only in raw SQL: Prisma can see column indexes it doesn't know about
  // and generates a DROP for them on the next diff. (An expression index —
  // Post_fts_idx, over the weighted tsvector — is invisible to Prisma and does
  // survive, which is why it stays in raw SQL.)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Post_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Post_description_trgm_idx")
}

model PostImage {
  id       String @id @default(cuid())
  postId   String
  url      String
  position Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([postId, createdAt])
}

// ---------------------------------------------------------------------------
// Matching — the centerpiece
// ---------------------------------------------------------------------------

// A scored, persisted suggestion that two posts describe the same item.
// Persisted (rather than computed on read) so we can notify once, let users
// dismiss bad suggestions, and measure precision later.
model Match {
  id          String @id @default(cuid())
  sourceId    String // the newly created post that triggered the search
  candidateId String // the pre-existing post it might pair with

  score        Float // 0..1 combined score
  textScore    Float // full-text + trigram similarity component
  categoryHit  Boolean
  locationHit  Boolean
  daysApart    Int

  notifiedAt  DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  source    Post @relation("MatchSource", fields: [sourceId], references: [id], onDelete: Cascade)
  candidate Post @relation("MatchCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([sourceId, candidateId])
  @@index([candidateId, score])
}

// ---------------------------------------------------------------------------
// Claims — anti-theft flow
// ---------------------------------------------------------------------------

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model Claim {
  id         String      @id @default(cuid())
  postId     String
  claimantId String
  // The claimant's answer to the withheld detail. Reviewed by the post author.
  answer     String
  status     ClaimStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  decidedAt  DateTime?

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  claimant User @relation(fields: [claimantId], references: [id], onDelete: Cascade)

  // One open claim per person per post — stops claim spam.
  @@unique([postId, claimantId])
  @@index([postId, status])
}

// ---------------------------------------------------------------------------
// Direct messages
// ---------------------------------------------------------------------------

// Always anchored to a post: DMs exist to resolve a specific item, not to be a
// general chat app. Keeps moderation scope small and intent obvious.
model Conversation {
  id        String   @id @default(cuid())
  postId    String
  finderId  String // the post author
  seekerId  String // the person who initiated
  createdAt DateTime @default(now())

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  finder   User      @relation("ConversationFinder", fields: [finderId], references: [id], onDelete: Cascade)
  seeker   User      @relation("ConversationSeeker", fields: [seekerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([postId, seekerId])
  @@index([finderId])
  @@index([seekerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications & moderation
// ---------------------------------------------------------------------------

enum NotificationType {
  MATCH_FOUND
  NEW_COMMENT
  NEW_MESSAGE
  CLAIM_SUBMITTED
  CLAIM_APPROVED
  CLAIM_REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  // Denormalized payload (post title, actor name, link) so rendering the
  // notification list is a single query with no joins.
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

enum ReportReason {
  SPAM
  HARASSMENT
  SCAM_OR_FALSE_CLAIM
  PERSONAL_INFO
  OTHER
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  postId     String?
  commentId  String?
  reason     ReportReason
  detail     String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  reporter User     @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  post     Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
}
